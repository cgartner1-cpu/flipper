<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableHarmony>true</EnableHarmony>
    <AssemblyName>ZagreusValley</AssemblyName>
    <RootNamespace>ZagreusValley</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- finds the game install (GamePath) and deploys to Mods/ on build -->
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
    <!-- Hades .pkg chunks are LZ4 block compressed (MIT) -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <!-- decodes the BC3/BC7 textures inside Hades packages (MIT) -->
    <PackageReference Include="BCnEncoder.Net" Version="2.1.0" />
  </ItemGroup>
</Project>
